package com.cwls.controller;

import com.cwls.model.Attendance;
import com.cwls.model.WorkLog;
import com.cwls.service.CWLSService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api")
@CrossOrigin(origins = "*")
public class AppController {

    @Autowired
    private CWLSService cwlsService;

    @PostMapping("/attendance/check-in/{empId}")
    public ResponseEntity<Attendance> checkIn(@PathVariable Long empId) {
        return ResponseEntity.ok(cwlsService.checkIn(empId));
    }

    @PostMapping("/attendance/check-out/{empId}")
    public ResponseEntity<Attendance> checkOut(@PathVariable Long empId) {
        return ResponseEntity.ok(cwlsService.checkOut(empId));
    }

    @PostMapping("/worklogs/submit/{empId}")
    public ResponseEntity<WorkLog> submitWorkLog(@PathVariable Long empId,
                                                 @RequestParam String task,
                                                 @RequestParam Double hours) {
        return ResponseEntity.ok(cwlsService.submitWorkLog(empId, task, hours));
    }

    @GetMapping("/admin/worklogs/pending")
    public ResponseEntity<List<WorkLog>> getPendingWorkLogs() {
        return ResponseEntity.ok(cwlsService.getPendingWorkLogs());
    }

    @PutMapping("/admin/worklogs/approve/{logId}")
    public ResponseEntity<WorkLog> approveWorkLog(@PathVariable Long logId) {
        return ResponseEntity.ok(cwlsService.approveWorkLog(logId));
    }
}
